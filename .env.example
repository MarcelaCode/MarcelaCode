# ============================================================
# Variáveis de ambiente do n8n — Vamos Sorrir
# NUNCA commitar o .env. Valores abaixo são marcadores, não credenciais.
# Exigido no n8n:  N8N_BLOCK_ENV_ACCESS_IN_NODE=false   NODE_FUNCTION_ALLOW_BUILTIN=crypto
# ============================================================
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
NODE_FUNCTION_ALLOW_BUILTIN=crypto

# --- Clínica (gere com: npm run env:config) ---
CLINICA_CONFIG_JSON=

# --- WhatsApp Business Cloud API (Meta) ---
WHATSAPP_API_VERSION=v21.0            # confirme a versão vigente no painel da Meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=                # token de usuário do sistema (permanente), nunca token temporário em produção
WHATSAPP_APP_SECRET=                  # valida a assinatura X-Hub-Signature-256
WHATSAPP_VERIFY_TOKEN=                # string aleatória longa, usada só na verificação do webhook

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5       # decisão de custo/qualidade é sua; ex.: claude-sonnet-5-5 (mais barato)
ANTHROPIC_EFFORT=medium               # low | medium | high
# ANTHROPIC_API_URL=                  # opcional (proxy/gateway); padrão https://api.anthropic.com

# --- Transcrição de áudio (API compatível com /v1/audio/transcriptions) ---
TRANSCRIBE_API_URL=                   # ex.: https://api.openai.com/v1/audio/transcriptions (envolve transferência internacional de dados: veja docs/06-lgpd.md)
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-1

# --- Google Planilhas ---
SHEETS_ID=                            # ID da planilha (somente a clínica tem acesso; NUNCA link público)
SHEET_GID_SESSOES=                    # gid de cada aba (número após #gid= na URL), usado pela rotina de retenção
SHEET_GID_FILA_ENTRADA=
SHEET_GID_ERROS=
SHEET_GID_LEMBRETES=
SHEET_GID_AUDITORIA=
# Google Agenda e Planilhas usam credenciais OAuth2 do próprio n8n (não ficam em variáveis).
